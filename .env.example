# ==============================================================================
# CityAI Traffic Intelligence - Environment Configuration
# ==============================================================================

# Application Meta
PROJECT_NAME="CityAI Traffic Intelligence"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration (SQLite for local / Phase 1)
DATABASE_URL="sqlite:///./traffic_intelligence.db"

# Future Phases Configurations (Computer Vision / Simulation)
# SIMULATION_FPS=10
# VEHICLE_DETECTION_CONFIDENCE=0.45
# OCR_MIN_CONFIDENCE=0.50
